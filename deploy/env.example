# Copy to an untracked local file and review before exporting it.
# This file is shell-compatible; keep values without spaces, or quote them.
# Deployment target: no project/account is inferred from active gcloud settings.
GOOGLE_CLOUD_PROJECT=replace-with-your-project-id
GOOGLE_CLOUD_REGION=europe-west2
CLOUD_RUN_SERVICE=shopify-ops
DEPLOYMENT_OWNER=commerce-team
DEPLOYER_ACCOUNT=replace-with-your-google-account@example.com
RUNTIME_SERVICE_ACCOUNT=shopify-ops-runtime@replace-with-your-project-id.iam.gserviceaccount.com
BUILD_SERVICE_ACCOUNT=shopify-ops-build@replace-with-your-project-id.iam.gserviceaccount.com
CLOUD_SQL_INSTANCE=replace-with-your-project-id:europe-west2:shopify-ops-db
APP_URL=https://replace-with-your-app-domain.example.com
SHOPIFY_API_KEY=replace-with-the-app-client-id
SHOPIFY_SHOPS_ALLOWLIST=replace-with-your-store.myshopify.com
STORES_JSON='[{"id":"uk","name":"Company UK","domain":"replace-with-your-store.myshopify.com","country":"GB","currency":"GBP"}]'
# Configure these staff IDs, or the optional ADMIN_PASSWORD_SECRET below.
# At least one administrator login route is required before deployment.
SHOPIFY_ADMIN_USER_IDS=
DB_AUTO_MIGRATE=true
APP_MODE=production

# Existing Secret Manager names in GOOGLE_CLOUD_PROJECT. Versions are pinned.
# The deploy script never reads or prints the payloads of these secrets.
DATABASE_URL_SECRET=shopify-ops-database-url
DATABASE_URL_SECRET_VERSION=1
AUTH_SECRET_SECRET=shopify-ops-auth-secret
AUTH_SECRET_SECRET_VERSION=1
ENCRYPTION_KEY_SECRET=shopify-ops-encryption-key
ENCRYPTION_KEY_SECRET_VERSION=1
SHOPIFY_API_SECRET_SECRET=shopify-ops-shopify-api-secret
SHOPIFY_API_SECRET_SECRET_VERSION=1
# For separate Shopify apps per store, use this optional JSON secret instead of
# the shared SHOPIFY_API_KEY + SHOPIFY_API_SECRET_SECRET pair above.
SHOPIFY_SHOP_CREDENTIALS_SECRET=
SHOPIFY_SHOP_CREDENTIALS_SECRET_VERSION=1
INTERNAL_TASK_SECRET_SECRET=shopify-ops-internal-task-secret
INTERNAL_TASK_SECRET_SECRET_VERSION=1

# Optional internal preview login and email delivery.
ADMIN_PASSWORD_SECRET=
ADMIN_PASSWORD_SECRET_VERSION=1
RESEND_API_KEY_SECRET=
RESEND_API_KEY_SECRET_VERSION=1
MAIL_FROM=
# Optional existing private GCS bucket; no bucket is provisioned by this script.
GCS_BUCKET=

# Bounded initial runtime settings. Review alongside the actual DB pool size.
MIN_INSTANCES=0
MAX_INSTANCES=3
CONCURRENCY=20
MEMORY=512Mi
CPU=1
REQUEST_TIMEOUT=120
# Updating an existing Cloud Run service needs this explicit opt-in.
ALLOW_UPDATE_EXISTING=0

# Local compose only; fill these locally, never in source control.
# Generate URL-safe POSTGRES_PASSWORD and AUTH_SECRET: openssl rand -hex 32
# Generate ENCRYPTION_KEY: openssl rand -base64 32
POSTGRES_PASSWORD=
AUTH_SECRET=
ENCRYPTION_KEY=
ADMIN_PASSWORD=
SHOPIFY_API_SECRET=
SHOPIFY_SHOP_CREDENTIALS=
INTERNAL_TASK_SECRET=
RESEND_API_KEY=
