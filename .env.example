# Default local demonstration: npm ci && npm run dev
# Demo data is temporary and never authorizes Shopify or external emails.
APP_MODE=demo
PORT=8080
APP_URL=http://localhost:8080

# Production is fail-closed: copy values privately into Secret Manager rather
# than committing them. The Cloud Run deployment example is deploy/env.example.
# APP_MODE=production
# APP_URL=https://app.your-company.example
# DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@/DATABASE?host=/cloudsql/PROJECT:REGION:INSTANCE
# STORES_JSON=[{"id":"uk","name":"Company UK","domain":"your-uk-store.myshopify.com","country":"GB","currency":"GBP"}]
# AUTH_SECRET=<generate an independent random secret of at least 32 characters>
# ENCRYPTION_KEY=<openssl rand -base64 32>
# ADMIN_PASSWORD=<optional internal admin password of at least 16 characters>
# INTERNAL_TASK_SECRET=<another independently generated random secret>
# SHOPIFY_API_KEY=<client id>
# SHOPIFY_API_SECRET=<client secret>
# SHOPIFY_SHOP_CREDENTIALS={"your-uk-store.myshopify.com":{"apiKey":"...","apiSecret":"...","storefrontToken":"private Storefront token"}}
# SHOPIFY_ADMIN_USER_IDS=<comma separated authorized staff ids>
# RESEND_API_KEY=<email provider API key>
# MAIL_FROM=Company <verified-sender@your-company.example>
