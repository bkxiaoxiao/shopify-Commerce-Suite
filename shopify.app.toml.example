# Review template only. Copy to a per-app shopify.app.<store>.toml and replace
# EVERY REPLACE_* value. This file is not an active Shopify CLI configuration.
client_id = "REPLACE_SHOPIFY_CLIENT_ID"
name = "Commerce Suite Internal"
application_url = "https://REPLACE_APP_HOST"
embedded = true

[build]
automatically_update_urls_on_dev = false

[access_scopes]
scopes = "read_products,read_inventory,read_locations,read_orders,write_shipping,write_discounts,write_app_proxy"

[auth]
redirect_urls = ["https://REPLACE_APP_HOST/auth/callback"]

[webhooks]
api_version = "2026-10"
# App-specific subscriptions are applied when this app configuration is deployed.
[[webhooks.subscriptions]]
topics = ["orders/paid", "refunds/create", "products/create", "products/update", "products/delete", "inventory_levels/update", "inventory_levels/connect", "inventory_levels/disconnect", "app/uninstalled"]
uri = "/webhooks"

[[webhooks.subscriptions]]
compliance_topics = ["customers/data_request", "customers/redact", "shop/redact"]
uri = "/webhooks"

[app_proxy]
url = "https://REPLACE_APP_HOST/proxy"
prefix = "apps"
subpath = "commerce-suite"

# This extension fetches only same-origin Shopify routes through the App Proxy.
# No secrets or Admin API tokens belong in this file or in extension assets.
